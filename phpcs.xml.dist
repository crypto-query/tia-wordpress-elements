<?xml version="1.0"?>
<ruleset name="tia-wordpress-elements">
    <description>WordPress Coding Standards for the tia-wordpress-elements plugin.</description>

    <file>.</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
    <exclude-pattern>*/.agents/*</exclude-pattern>
    <exclude-pattern>*/.scratch/*</exclude-pattern>
    <exclude-pattern>*/wordpress/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="WordPress"/>

    <rule ref="PHPCompatibilityWP"/>
    <config name="testVersion" value="8.3-"/>

    <!-- PHPUnit runs without WordPress, so the WordPress replacements for file functions do not exist there. -->
    <rule ref="WordPress.WP.AlternativeFunctions">
        <exclude-pattern>*/tests/php/*</exclude-pattern>
    </rule>

    <!-- The PHPUnit bootstrap stands in for WordPress core, so it defines core's ABSPATH. -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedConstantFound">
        <exclude-pattern>*/tests/php/bootstrap.php</exclude-pattern>
    </rule>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="tia-wordpress-elements"/>
            </property>
        </properties>
    </rule>

    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="tia_elements"/>
                <element value="TIA_Elements"/>
                <element value="tia_"/>
            </property>
        </properties>
    </rule>
</ruleset>
